# FTP Deploy (로컬 .env.local에만 작성, 배포 스크립트용)
FTP_HOST=ftpupload.net
FTP_USER=if0_xxxxxxx
FTP_PASS=your_ftp_password
FTP_REMOTE_DIR=/htdocs

# Database
DB_HOST=sql123.infinityfree.com
DB_NAME=if0_xxxxxxx_notto
DB_USER=if0_xxxxxxx
DB_PASS=your_password

# Gemini API
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Admin
# 로컬: .env.local에 작성 (docker-compose env_file로 주입)
# 배포: InfinityFree .env에 직접 작성
ADMIN_KEY=your_secure_random_key

# App
APP_ENV=production
APP_DEBUG=false
DIRECT_REGISTER=false
